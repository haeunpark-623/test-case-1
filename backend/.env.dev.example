# Backend dev profile — workspace-scoped (.env.dev), LOCAL.md §1.5.1 (e) 채택
# 실제 .env.dev는 본 .example을 카피해서 사용. 평문 파일 commit 금지 (CLAUDE.md 보안 절대 규칙).

# 12-scaffolding/typescript.md §6 표 dev 컬럼 + LOCAL.md §3.1 정합
DATABASE_URL=postgresql://conduit:conduit@localhost:5432/conduit_dev
JWT_SECRET=dev-secret-min-32-chars-aaaaaaaaaa
JWT_EXP_SECONDS=604800
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173

# docker-compose db service용 (compose가 --env-file로 직접 읽음)
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit_dev
