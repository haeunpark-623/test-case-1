# Backend prod profile — workspace-scoped (.env.prod), LOCAL.md §1.5.1 (e) 채택
# 실제 .env.prod의 시크릿(JWT_SECRET·DATABASE_URL password)은 secret manager에서 injection.
# 본 .example은 placeholder만 — 평문 파일 commit 금지 (CLAUDE.md 보안 절대 규칙).

# 12-scaffolding/typescript.md §6 표 prod 컬럼 + LOCAL.md §3.3 정합
DATABASE_URL=postgresql://conduit:REPLACE_FROM_SECRET_MANAGER@db:5432/conduit_prod
JWT_SECRET=REPLACE_FROM_SECRET_MANAGER_MIN_32_CHARS
JWT_EXP_SECONDS=604800
PORT=4000
NODE_ENV=production
LOG_LEVEL=warn
CORS_ALLOWED_ORIGINS=https://conduit.example.com

# docker-compose db service용 (운영은 별 인스턴스 권장 — secret manager)
POSTGRES_USER=conduit
POSTGRES_PASSWORD=REPLACE_FROM_SECRET_MANAGER
POSTGRES_DB=conduit_prod
