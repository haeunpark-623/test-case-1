# Backend stg profile — workspace-scoped (.env.stg), LOCAL.md §1.5.1 (e) 채택
# 실제 .env.stg는 본 .example을 카피해서 사용. 평문 파일 commit 금지.

# 12-scaffolding/typescript.md §6 표 stg 컬럼 + LOCAL.md §3.2 정합
DATABASE_URL=postgresql://conduit:conduit@db:5432/conduit_stg
JWT_SECRET=stg-secret-min-32-chars-bbbbbbbbbb
JWT_EXP_SECONDS=604800
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://stg.conduit.example.com

# docker-compose db service용
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit_stg
