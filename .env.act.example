# act 로컬 실행용 secrets/env placeholder — LOCAL.md §5.5 참조
# 사용: cp .env.act.example .env.act 후 값 채움. 평문 commit 금지 (gitignored).

# GitHub Actions 환경 변수 placeholder
GITHUB_TOKEN=ghp_placeholder_not_real
NODE_VERSION=20
PNPM_VERSION=9.15.4

# Postgres service env (ci.yml services.db와 정합)
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit_dev

# Prisma SSL fallback (회사망에서 act 실행 시) — 필요 시 활성화
# NODE_TLS_REJECT_UNAUTHORIZED=0
# PRISMA_ENGINES_MIRROR=<사내 mirror URL>
# NODE_EXTRA_CA_CERTS=/path/to/company-ca.crt
